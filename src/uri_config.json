{
  "basePath": "/next",
  "routes": {
    "community": {
      "services": {
        "development": {
          "source": "/services/development",
          "destination": "/community/services/development"
        },
        "nationalMarket": {
          "source": "/convert_national_market",
          "destination": "/community/services/national_market"
        },
        "support": {
          "source": "/support",
          "destination": "/community/services/support_page"
        }
      },
      "features": {
        "source": "/features",
        "destination": "/community/features"
      },
      "docs": {
        "source": "/docs",
        "destination": "/community/docs"
      },
      "docsNested": {
        "source": "/docs/:path*",
        "destination": "/community/docs/:path*"
      },
      "clearSildeBar": {
        "source": "/clear_silde_bar",
        "destination": "/community/clear_silde_bar"
      },
      "technicalInsights": {
        "source": "/tech/:uri",
        "destination": "/community/technical_insights?uri=:uri"
      }
    },
    "history": {
      "home": {
        "source": "/history/home",
        "destination": "/resources/history/home"
      },
      "communityAlias": {
        "source": "/community/history/home",
        "destination": "/resources/history/home"
      },
      "shopAlias": {
        "source": "/shop/history/home",
        "destination": "/resources/history/home"
      }
    },
    "info": {
      "termsService": {
        "source": "/info/terms_service",
        "destination": "/info/terms_service"
      },
      "privatePolicy": {
        "source": "/info/private_policy",
        "destination": "/info/private_policy"
      },
      "aboutUs": {
        "source": "/info/about_us",
        "destination": "/info/about_us"
      }
    },
    "resource": {
      "productPlay": {
        "source": "/resource/product/play/:slug",
        "destination": "/resources/play/:slug"
      },
      "accountsProductPlay": {
        "source": "/accounts/product/play/:slug",
        "destination": "/resources/play/:slug"
      }
    },
    "shop": {
      "hustAdmin": {
        "source": "/hustadmin",
        "destination": "/shop/hustadmin"
      },
      "n8n": {
        "source": "/hustadmin/n8n",
        "destination": "/api/hust_media/workflow/laravel"
      },
      "cronServer": {
        "source": "/hustadmin/cron_server",
        "destination": "/shop/hustadmin/port_cron/scheduler"
      },
      "netPorts": {
        "source": "/hustadmin/net_ports",
        "destination": "/shop/hustadmin/port_cron/net_ports"
      },
      "orders": {
        "source": "/hustadmin/orders",
        "destination": "/shop/hustadmin/orders"
      },
      "hustAdminNested": {
        "source": "/hustadmin/:path*",
        "destination": "/shop/hustadmin/:path*"
      },
      "scamsCheck": {
        "profile": {
          "source": "/check/:slug",
          "destination": "/shop/scams_check/profile/:slug"
        },
        "nested": {
          "source": "/check/:path*",
          "destination": "/shop/scams_check/:path*"
        }
      },
      "ai": {
        "ordersOnce": {
          "source": "/orders_once/:slug_2",
          "destination": "/shop/ai?slug_2=:slug_2"
        },
        "history": {
          "source": "/shop/ai/:slug_2(speech_text|text_speech|image_text|translate_vi_en|text_workflow)",
          "destination": "/shop/ai?slug_2=:slug_2"
        }
      }
    },
    "api": {
      "hust": {
        "home": {
          "source": "/api/hust/home",
          "destination": "/api/hust_media/media_tech/dashboard"
        },
        "laravel": {
          "source": "/api/hust/laravel",
          "destination": "/api/hust_media/media_tech/laravel"
        },
        "openclaw": {
          "source": "/api/hust/openclaw",
          "destination": "/api/hust_media/media_tech/openclaw"
        },
        "chatTest": {
          "source": "/api/hust/chat_test",
          "destination": "/api/hust_media/media_tech/chat_test"
        },
        "chatPublic": {
          "source": "/api/hust/chat_public",
          "destination": "/api/hust_media/media_tech/chat_public"
        },
        "apiTest": {
          "source": "/api/hust/api_test",
          "destination": "/api/hust_media/api"
        },
        "workflow": {
          "source": "/api/hust/workflow",
          "destination": "/api/hust_media/workflow"
        },
        "workflowLaravel": {
          "source": "/api/hust/workflow/laravel",
          "destination": "/api/hust_media/workflow/laravel"
        },
        "n8n": {
          "source": "/api/hust/n8n",
          "destination": "/api/hust_media/n8n"
        },
        "n8nLaravel": {
          "source": "/api/hust/n8n/laravel",
          "destination": "/api/hust_media/n8n/laravel"
        },
        "workspace": {
          "source": "/api/hust/workspace",
          "destination": "/api/hust_media/workspace"
        }
      },
      "chatProxy": {
        "source": "/api/chat/:path*",
        "destination": "/api/media_tech/chat/:path*"
      },
      "giteaProxy": {
        "source": "/api/gitea/:path*",
        "destination": "/api/media_tech/gitea/:path*"
      },
      "openclawProxy": {
        "source": "/api/openclaw/:path*",
        "destination": "/api/media_tech/openclaw/gateway/:path*"
      },
      "workspaces": {
        "source": "/api/workspaces/:path*",
        "destination": "/api/media_tech/workspaces/:path*"
      },
      "workspacesProxy": {
        "source": "/api/workspaces-proxy/:path*",
        "destination": "/api/media_tech/workspaces-proxy/:path*"
      },
      "nodeActivity": {
        "source": "/api/node-activity/:path*",
        "destination": "/api/media_tech/node-activity/:path*"
      },
      "sidebarMenu": {
        "source": "/api/sidebar-menu",
        "destination": "/api/media_tech/sidebar-menu"
      },
      "sidebarMenuClear": {
        "source": "/api/sidebar-menu/clear",
        "destination": "/api/media_tech/sidebar-menu/clear"
      }
    },
    "md": {
      "homeRoot": {
        "source": "/api/mt",
        "destination": "/api/media_tech"
      },
      "chatTest": {
        "source": "/api/mt/chat_test",
        "destination": "/api/media_tech/chat_test"
      },
      "chatPublic": {
        "source": "/api/mt/chat_public",
        "destination": "/api/media_tech/chat_public"
      },
      "heygen": {
        "source": "/api/mt/media/heygen/:path*",
        "destination": "/api/media_tech/heygen/:path*"
      },
      "openclaw": {
        "source": "/api/mt/openclaw",
        "destination": "/api/media_tech/openclaw"
      },
      "laravel": {
        "source": "/api/mt/laravel",
        "destination": "/api/media_tech/laravel"
      },
      "n8n": {
        "source": "/api/mt/n8n",
        "destination": "/api/media_tech/n8n"
      },
      "n8nNodeJs": {
        "source": "/api/mt/n8n/node_js",
        "destination": "/api/media_tech/n8n/node_js"
      },
      "n8nMapsMain": {
        "source": "/api/mt/n8n/maps_main",
        "destination": "/api/media_tech/maps_main"
      },
      "n8nLaravel": {
        "source": "/api/mt/n8n/laravel",
        "destination": "/api/media_tech/n8n/laravel"
      },
      "workspace": {
        "source": "/api/mt/workspace",
        "destination": "/api/media_tech/workspace"
      },
      "home": {
        "source": "/api/mt/home",
        "destination": "/api/media_tech/dashboard"
      },
      "gitAuto": {
        "source": "/api/mt/git_auto",
        "destination": "/api/media_tech/git_auto"
      },
      "gitTest": {
        "source": "/api/mt/git_test",
        "destination": "/api/media_tech/git_test"
      },
      "giteaTest": {
        "source": "/api/mt/gitea_test",
        "destination": "/api/media_tech/gitea_test"
      }
    }
  },
  "locale": {
    "segmentPattern": "^[a-zA-Z]{2}$",
    "cookieName": "national_market",
    "cookieMaxAgeSeconds": 31536000
  }
}
